[
  {
    "id": "sample-papers",
    "name": "Sample Papers API",
    "enabled": false,
    "kind": "paper",
    "endpoint": "https://example.com/api/papers",
    "method": "GET",
    "authType": "none",
    "headers": {
      "accept": "application/json"
    },
    "query": {
      "limit": "20"
    },
    "mapping": {
      "itemsPath": "data.items",
      "titlePath": "title",
      "urlPath": "url",
      "datePath": "publishedAt",
      "summaryPath": "summary",
      "authorsPath": "authors",
      "tagsPath": "tags",
      "typePath": "type"
    },
    "timeoutMs": 6000,
    "priority": 10
  }
]
